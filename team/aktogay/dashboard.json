{
  "uid": "aktogay-shift-twin",
  "title": "Aktogay Sulphide Shift Twin",
  "tags": [
    "openegiz",
    "aktogay",
    "mine"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "description": "Synthetic operating telemetry for the one-line Aktogay sulphide twin. Not production data.",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Concentrator feed rate",
      "datasource": {
        "type": "influxdb",
        "uid": "opentwins-influxdb"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "t/h",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "lineInterpolation": "stepAfter"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "opentwins-influxdb"
          },
          "query": "from(bucket: \"default\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r.thingId == \"org.aktogay:concentrator-01\" and r._field == \"value_feed_rate_properties_value\")\n  |> keep(columns: [\"_time\", \"_value\", \"thingId\"])"
        }
      ]
    },
